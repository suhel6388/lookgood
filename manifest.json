{
  "manifest_version": 3,
  "name": "LookGood Live",
  "version": "0.1.0",
  "description": "Real-time webcam effects for any video call. Skin smoothing, color, light, sharpening, portrait lighting and background blur, processed on your device.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.discord.com/*",
    "https://*.whereby.com/*",
    "https://meet.jit.si/*",
    "https://*.webex.com/*",
    "https://*.skype.com/*",
    "https://*.slack.com/*",
    "https://webrtc.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "LookGood Live",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.discord.com/*",
        "https://*.whereby.com/*",
        "https://meet.jit.si/*",
        "https://*.webex.com/*",
        "https://*.skype.com/*",
        "https://*.slack.com/*",
        "https://webrtc.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.discord.com/*",
        "https://*.whereby.com/*",
        "https://meet.jit.si/*",
        "https://*.webex.com/*",
        "https://*.skype.com/*",
        "https://*.slack.com/*",
        "https://webrtc.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models/*", "mediapipe/wasm/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
